<!doctype html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <a href="#main" class="skip-link"><%= t.nav.skipLink %></a>

  <%- include('partials/navbar') %>

  <main id="main">
    <!-- HERO SECTION -->
    <section class="hero">
      <div class="container hero__content">
        <div class="hero__brand-badge">
          <img src="/public/images/logo-icon.png" alt="Danuxy Studio" class="hero__logo" width="76" height="76" fetchpriority="high" decoding="async" />
        </div>
        <p class="hero__subtitle-tag"><%= t.home.heroTagline %></p>
        <h1 class="hero__title"><%= t.home.heroTitle %></h1>
        <p class="hero__desc"><%= t.home.heroDesc %></p>
        <div class="hero__actions">
          <a href="/projects" class="btn btn--primary"><i class="fas fa-folder-open"></i> <%= t.common.exploreProjects %></a>
          <a href="/contact" class="btn btn--outline"><i class="fas fa-paper-plane"></i> <%= t.common.letsWorkTogether %></a>
          <a href="/links" class="btn btn--ghost"><i class="fas fa-link"></i> <%= lang === 'en' ? 'Links Hub' : 'Direktori & Komunitas' %></a>
        </div>
      </div>
    </section>

    <!-- INTRO & PHILOSOPHY -->
    <section class="section">
      <div class="container">
        <div class="intro">
          <div>
            <p class="section__label"><%= t.home.aboutLabel %></p>
            <h2 class="section__title"><%= t.home.aboutTitle %></h2>
            <p class="section__desc"><%= t.home.aboutDesc %></p>
            <div class="intro__philosophy">
              <span class="intro__philosophy-tag"><i class="fas fa-arrows-rotate"></i> <%= lang === 'en' ? 'Workflow:' : 'Alur Kerja:' %></span>
              <div class="intro__steps-list">
                <% t.home.philosophy.forEach(function(step, idx) { %>
                  <span class="intro__step"><%= step %></span>
                  <% if (idx < t.home.philosophy.length - 1) { %>
                    <span class="intro__step-arrow" aria-hidden="true"><i class="fas fa-chevron-right"></i></span>
                  <% } %>
                <% }); %>
              </div>
            </div>
          </div>
          <div>
            <div class="intro__card">
              <div class="intro__card-header">
                <div class="intro__card-badge">
                  <span class="pulse-dot"></span>
                  <span><%= lang === 'en' ? 'Ecosystem Snapshot' : 'Ringkasan Ekosistem' %></span>
                </div>
                <span class="intro__card-meta">Live & Active</span>
              </div>
              <div class="intro__card-items">
                <div class="intro__feature-pill">
                  <div class="intro__feature-icon" style="color: #25d366;"><i class="fab fa-whatsapp"></i></div>
                  <div class="intro__feature-text">
                    <strong>NIXI Platform SaaS</strong>
                    <small><%= lang === 'en' ? 'Autonomous WhatsApp Gateway & Multi-Device Bot' : 'Gateway WhatsApp Mandiri & Multi-Device' %></small>
                  </div>
                </div>
                <div class="intro__feature-pill">
                  <div class="intro__feature-icon" style="color: #38bdf8;"><i class="fas fa-cube"></i></div>
                  <div class="intro__feature-text">
                    <strong>DanuxyCore Engine</strong>
                    <small><%= lang === 'en' ? 'Dual Native GUI for Java & Bedrock (Zero Mod)' : 'Dual Native GUI Java 1.21.8+ & Bedrock' %></small>
                  </div>
                </div>
                <div class="intro__feature-pill">
                  <div class="intro__feature-icon" style="color: #f59e0b;"><i class="fas fa-gem"></i></div>
                  <div class="intro__feature-text">
                    <strong>Danuxy Store & Digital</strong>
                    <small><%= lang === 'en' ? 'Verified Premium Apps & Instant Game Top-Up' : 'Akun Premium Resmi & Top Up Game Cepat' %></small>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FEATURED PROJECTS -->
    <section class="section section--alt">
      <div class="container">
        <div class="section__head section__head--center">
          <p class="section__label"><%= t.home.featuredLabel %></p>
          <h2 class="section__title"><%= t.home.featuredTitle %></h2>
        </div>
        <div class="projects-grid">
          <% projects.forEach(function(project) { %>
          <div class="project-card">
            <div class="project-card__body">
              <span class="project-card__category"><%= project.category %></span>
              <h3 class="project-card__title"><%= project.name %></h3>
              <p class="project-card__desc"><%= project.description %></p>
              
              <div class="project-card__actions">
                <% if (project.link) { %>
                <a href="<%= project.link %>" class="btn btn--outline btn--sm project-card__btn-detail">
                  <%= t.common.viewDetails %> <i class="fas fa-arrow-right"></i>
                </a>
                <% } %>

                <% if (project.externalLink) { %>
                <a href="<%= project.externalLink %>" target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp btn--sm project-card__btn-external">
                  <i class="fab fa-whatsapp"></i> <%= t.common.visitNixi %> <i class="fas fa-external-link-alt" style="font-size:0.75rem;"></i>
                </a>
                <% } %>
              </div>
            </div>
          </div>
          <% }); %>
        </div>
        <div style="text-align: center; margin-top: 32px;">
          <a href="/projects" class="btn btn--ghost"><%= t.common.viewAllProjects %></a>
        </div>
      </div>
    </section>

    <!-- WHAT WE BUILD -->
    <section class="section">
      <div class="container">
        <div class="section__head section__head--center">
          <p class="section__label"><%= t.home.whatWeBuildLabel %></p>
          <h2 class="section__title"><%= t.home.whatWeBuildTitle %></h2>
        </div>
        <div class="category-grid">
          <div class="category-card">
            <div class="category-card__icon"><i class="fab fa-whatsapp"></i></div>
            <div class="category-card__content">
              <h3><%= t.home.categories.wa.title %></h3>
              <p><%= t.home.categories.wa.desc %></p>
            </div>
          </div>
          <div class="category-card">
            <div class="category-card__icon"><i class="fas fa-cubes"></i></div>
            <div class="category-card__content">
              <h3><%= t.home.categories.mc.title %></h3>
              <p><%= t.home.categories.mc.desc %></p>
            </div>
          </div>
          <div class="category-card">
            <div class="category-card__icon"><i class="fas fa-globe"></i></div>
            <div class="category-card__content">
              <h3><%= t.home.categories.web.title %></h3>
              <p><%= t.home.categories.web.desc %></p>
            </div>
          </div>
          <div class="category-card">
            <div class="category-card__icon"><i class="fas fa-flask"></i></div>
            <div class="category-card__content">
              <h3><%= t.home.categories.exp.title %></h3>
              <p><%= t.home.categories.exp.desc %></p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- STUDIO ADVANTAGES -->
    <section class="section section--alt">
      <div class="container">
        <div class="section__head section__head--center">
          <p class="section__label"><%= t.home.advantagesLabel %></p>
          <h2 class="section__title"><%= t.home.advantagesTitle %></h2>
        </div>
        <div class="category-grid">
          <% t.home.advantages.forEach(function(adv) { %>
          <div class="category-card">
            <div class="category-card__icon"><i class="fas <%= adv.icon %>"></i></div>
            <div class="category-card__content">
              <h3><%= adv.title %></h3>
              <p><%= adv.desc %></p>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- LATEST ARTICLES -->
    <section class="section">
      <div class="container">
        <div class="section__head section__head--center">
          <p class="section__label"><%= t.home.articlesLabel %></p>
          <h2 class="section__title"><%= t.home.articlesTitle %></h2>
        </div>
        <div class="articles-grid">
          <% articles.forEach(function(article) { %>
          <a href="/blog/<%= article.slug %>" class="article-card">
            <div class="article-card__meta">
              <span class="article-card__category"><%= article.category %></span>
              <span>•</span>
              <time datetime="<%= article.date %>"><%= article.dateFormatted %></time>
            </div>
            <h3><%= article.title %></h3>
            <p><%= article.excerpt %></p>
          </a>
          <% }); %>
        </div>
        <div style="text-align: center; margin-top: 32px;">
          <a href="/blog" class="btn btn--ghost"><%= lang === 'en' ? 'View All Articles' : 'Lihat Semua Artikel' %></a>
        </div>
      </div>
    </section>

    <!-- FAQ SECTION -->
    <section class="section section--alt" id="faq">
      <div class="container">
        <div class="section__head section__head--center">
          <p class="section__label"><%= t.home.faqLabel %></p>
          <h2 class="section__title"><%= t.home.faqTitle %></h2>
        </div>
        <div class="faq-grid">
          <% t.home.faqList.forEach(function(faq) { %>
          <div class="faq-card">
            <h3 class="faq-card__q"><i class="fas fa-circle-question"></i> <%= faq.q %></h3>
            <p class="faq-card__a"><%= faq.a %></p>
          </div>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="cta-section">
      <div class="container">
        <h2 class="cta-section__title"><%= t.home.ctaTitle %></h2>
        <p class="cta-section__desc"><%= t.home.ctaDesc %></p>
        <a href="/contact" class="btn btn--primary"><%= t.home.ctaBtn %></a>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <%- include('partials/cookie-consent') %>

  <script src="/public/script.js" defer></script>
</body>
</html>
