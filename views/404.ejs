<!doctype html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'id' %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <a href="#main" class="skip-link"><%= typeof t !== 'undefined' ? t.nav.skipLink : 'Skip to content' %></a>
  <%- include('partials/navbar') %>

  <main id="main">
    <div class="container">
      <div class="error-page">
        <div class="error-page__code">404</div>
        <h1 class="error-page__title"><%= typeof t !== 'undefined' ? t.error404.title : 'Halaman Tidak Ditemukan' %></h1>
        <p class="error-page__desc"><%= typeof t !== 'undefined' ? t.error404.desc : 'Halaman yang Anda cari tidak dapat ditemukan.' %></p>
        <div style="display: flex; gap: 12px; flex-wrap: wrap; justify-content: center;">
          <a href="/" class="btn btn--primary"><i class="fas fa-home"></i> <%= typeof t !== 'undefined' ? t.error404.homeBtn : 'Kembali ke Beranda' %></a>
          <a href="/projects" class="btn btn--secondary"><i class="fas fa-folder-open"></i> <%= typeof t !== 'undefined' ? t.error404.projectsBtn : 'Lihat Projects' %></a>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
  <%- include('partials/cookie-consent') %>
  <script src="/public/script.js"></script>
</body>
</html>