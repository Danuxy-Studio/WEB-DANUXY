<div class="cookie-consent" id="cookieConsent" role="dialog" aria-label="Cookie Consent">
  <div class="cookie-consent__content">
    <p><%= t.cookieConsent.text %></p>
    <div class="cookie-consent__actions">
      <button class="cookie-consent__btn cookie-consent__btn--accept" id="cookieAccept"><%= t.cookieConsent.accept %></button>
      <a href="/cookies" class="cookie-consent__btn cookie-consent__btn--settings"><%= t.cookieConsent.settings %></a>
    </div>
  </div>
</div>
