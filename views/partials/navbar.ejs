<header class="header" id="header">
  <div class="container header__inner">
    <a href="/" class="header__logo">
      <img src="/public/images/logo-icon.png" alt="Danuxy Studio" width="36" height="36" decoding="async" />
      <span>Danuxy<span class="logo-dot">.</span></span>
    </a>

    <nav class="nav-desktop" id="navDesktop">
      <a href="/projects" class="<%= typeof currentPage !== 'undefined' && currentPage === 'projects' ? 'active' : '' %>"><%= t.nav.projects %></a>
      <a href="/services" class="<%= typeof currentPage !== 'undefined' && currentPage === 'services' ? 'active' : '' %>"><%= t.nav.services %></a>
      <a href="/blog" class="<%= typeof currentPage !== 'undefined' && currentPage === 'blog' ? 'active' : '' %>"><%= t.nav.blog %></a>
      <a href="/about" class="<%= typeof currentPage !== 'undefined' && currentPage === 'about' ? 'active' : '' %>"><%= t.nav.about %></a>
      <a href="/links" class="<%= typeof currentPage !== 'undefined' && currentPage === 'links' ? 'active' : '' %>"><%= t.nav.links %></a>
      <a href="/contact" class="<%= typeof currentPage !== 'undefined' && currentPage === 'contact' ? 'active' : '' %>"><%= t.nav.contact %></a>
    </nav>

    <div class="header__actions">
      <!-- Language Switcher -->
      <div class="lang-switch" id="langSwitch" role="group" aria-label="<%= t.common.langLabel %>">
        <button type="button" class="lang-btn <%= (typeof lang !== 'undefined' && lang === 'id') ? 'active' : '' %>" data-lang="id" title="Bahasa Indonesia" aria-label="Ganti bahasa ke Bahasa Indonesia">ID</button>
        <button type="button" class="lang-btn <%= (typeof lang !== 'undefined' && lang === 'en') ? 'active' : '' %>" data-lang="en" title="English" aria-label="Switch language to English">EN</button>
      </div>

      <!-- Theme Toggle -->
      <button class="theme-toggle" id="themeToggle" aria-label="<%= t.common.themeToggle %>">
        <i class="fas fa-moon" id="themeIcon" aria-hidden="true"></i>
      </button>

      <!-- Hamburger for Mobile -->
      <button class="hamburger" id="hamburger" aria-label="<%= t.common.menuToggle %>" aria-expanded="false">
        <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
    </div>

    <!-- Mobile Navigation Drawer -->
    <nav class="nav-mobile" id="navMobile" aria-label="<%= lang === 'en' ? 'Mobile Navigation' : 'Navigasi Mobile' %>">
      <div class="nav-mobile__header">
        <a href="/" class="header__logo">
          <img src="/public/images/logo-icon.png" alt="Danuxy Studio" width="32" height="32" />
          <span>Danuxy<span class="logo-dot">.</span></span>
        </a>
      </div>
      <a href="/" class="<%= typeof currentPage !== 'undefined' && currentPage === 'home' ? 'active' : '' %>"><i class="fas fa-home" aria-hidden="true"></i> <%= t.nav.home %></a>
      <a href="/projects" class="<%= typeof currentPage !== 'undefined' && currentPage === 'projects' ? 'active' : '' %>"><i class="fas fa-folder-open" aria-hidden="true"></i> <%= t.nav.projects %></a>
      <a href="/services" class="<%= typeof currentPage !== 'undefined' && currentPage === 'services' ? 'active' : '' %>"><i class="fas fa-cogs" aria-hidden="true"></i> <%= t.nav.services %></a>
      <a href="/blog" class="<%= typeof currentPage !== 'undefined' && currentPage === 'blog' ? 'active' : '' %>"><i class="fas fa-pen-nib" aria-hidden="true"></i> <%= t.nav.blog %></a>
      <a href="/about" class="<%= typeof currentPage !== 'undefined' && currentPage === 'about' ? 'active' : '' %>"><i class="fas fa-info-circle" aria-hidden="true"></i> <%= t.nav.about %></a>
      <a href="https://nixi.danuxy.com/" target="_blank" rel="noopener noreferrer"><i class="fab fa-whatsapp" aria-hidden="true"></i> <%= t.nav.nixi %> <i class="fas fa-external-link-alt" style="font-size:0.75rem; margin-left:auto;" aria-hidden="true"></i></a>
      <a href="/minecraft" class="<%= typeof currentPage !== 'undefined' && currentPage === 'minecraft' ? 'active' : '' %>"><i class="fas fa-cubes" aria-hidden="true"></i> <%= t.nav.minecraft %></a>
      <a href="/links" class="<%= typeof currentPage !== 'undefined' && currentPage === 'links' ? 'active' : '' %>"><i class="fas fa-link" aria-hidden="true"></i> <%= lang === 'en' ? 'Links Hub' : 'Direktori Tautan' %></a>
      <a href="/contact" class="nav-mobile__cta"><i class="fas fa-envelope" aria-hidden="true"></i> <%= t.nav.contact %></a>

      <!-- Mobile Language Switcher in Drawer -->
      <div class="nav-mobile__lang">
        <span class="nav-mobile__lang-label"><i class="fas fa-globe" aria-hidden="true"></i> <%= t.common.langLabel %>:</span>
        <div class="lang-switch lang-switch--mobile" role="group" aria-label="<%= t.common.langLabel %>">
          <button type="button" class="lang-btn <%= (typeof lang !== 'undefined' && lang === 'id') ? 'active' : '' %>" data-lang="id" aria-label="Ganti bahasa ke Bahasa Indonesia">ID</button>
          <button type="button" class="lang-btn <%= (typeof lang !== 'undefined' && lang === 'en') ? 'active' : '' %>" data-lang="en" aria-label="Switch language to English">EN</button>
        </div>
      </div>
    </nav>
  </div>
</header>
<div class="nav__overlay" id="navOverlay"></div>
